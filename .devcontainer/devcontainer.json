{
    "name": "Docker In Docker",
    "build": {
        "dockerfile": "./Dockerfile"
    },
    "runArgs": [
        "--volume=/var/lib/docker",
        "--privileged"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "editor.formatOnSave": true,
                "editor.formatOnPaste": true
            },
            "extensions": [
                "ms-azuretools.vscode-docker",
                "mhutchie.git-graph",
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker": "latest"
    }
}